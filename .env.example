# KC-CLI Environment Variables
# Copy this file to .env and fill in your values

# === API Configuration ===
KC_API_KEY=                    # LLM API key (required)
KC_PROVIDER=anthropic          # LLM provider: anthropic, openai, deepseek, qwen, glm, openai-compatible, ollama
KC_MODEL=                      # Model identifier (provider-specific default if empty)
KC_API_BASE_URL=               # Custom API endpoint (optional)

# === Permissions ===
KC_ALLOW_BYPASS=0              # Set to 1 to allow --bypass-permissions (required security opt-in)
KC_PERMISSION_MODE=default     # Permission mode: default, bypassPermissions, dontAsk, plan, acceptEdits, auto

# === Sandbox ===
KC_SANDBOX_ENABLED=true        # Enable sandbox isolation
KC_SANDBOX_BACKEND=bubblewrap  # Sandbox backend: docker, bubblewrap, seccomp, noop
KC_SANDBOX_ALLOW_NETWORK=false # Allow network access in sandbox
KC_SANDBOX_MAX_MEMORY_MB=512   # Sandbox memory limit (MB)
KC_SANDBOX_CPU_TIME_LIMIT_SEC=60 # Sandbox CPU time limit (seconds)
KC_SANDBOX_DEFAULT_ENFORCEMENT= # Default enforcement level
KC_SANDBOX_TOOL_POLICIES=      # Per-tool sandbox policies (JSON)

# === Memory ===
KC_MEMORY_ENABLED=true         # Enable persistent memory system
KC_MEMORY_AUTO_EXTRACT=true    # Auto-extract memories from conversations

# === Web Search ===
KC_SEARCH_PROVIDER=tavily      # Search provider: tavily, brave
KC_SEARCH_API_KEY=             # Search API key

# === General ===
KC_VERBOSE=false               # Enable verbose output
KC_CLI_BASE_DIR=               # Custom base directory for KC-CLI data
