    "commander": "^12.1.0",
    "diff": "^9.0.0",
    "highlight.js": "^11.11.1",
    "js-tiktoken": "^1.0.21",
    "uuid": "^9.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/highlight.js": "^9.12.4",
    "@types/node": "^25.5.2",
    "@types/uuid": "^9.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
