{
  "name": "kc-cli",
  "version": "3.2.0",
  "description": "Intelligent CLI Agent System - Server-side AI-powered development assistant",
  "main": "dist/main.js",
  "bin": {
    "kc": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npx tsx src/main.ts",
    "kc": "npx tsx src/main.ts",
    "build": "tsc",
    "prepack": "npm run build && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "npx vitest run",
    "test:vitest": "npx vitest run",
    "test:watch": "npx vitest",
    "test:coverage": "npx vitest run --coverage",
    "test:ci": "npx vitest run --coverage --reporter=verbose",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "eslint src --fix",
    "knip": "knip",
    "coverage:ratchet": "node scripts/coverage-ratchet.mjs"
  },
  "keywords": [
    "cli",
    "agent",
    "ai",
    "llm",
    "developer-tools"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.9.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "diff": "^9.0.0",
    "highlight.js": "^11.11.1",
    "ink": "^7.1.0",
    "js-tiktoken": "^1.0.21",
    "react": "^19.2.7",
    "uuid": "^11.1.1",
    "wrap-ansi": "^10.0.0",
    "ws": "^8.21.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/diff": "^7.0.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.17",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.8.0",
    "knip": "^6.32.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.5"
  }
}
